TELEGRAM_BOT_TOKEN=coloque_o_token_do_bot_aqui
TELEGRAM_CHAT_ID=coloque_o_seu_chat_id_aqui
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=telegram/webhook

ODDS_API_KEY=coloque_a_chave_da_odds_api_aqui
API_FOOTBALL_KEY=coloque_a_chave_da_api_football_aqui
SPORTMONKS_API_TOKEN=coloque_a_chave_da_sportmonks_aqui
THESTATSAPI_KEY=coloque_a_chave_da_thestatsapi_aqui
TOTALCORNER_TOKEN=coloque_o_token_vip_da_totalcorner_aqui

# Opcional, mas recomendado para a IA decidir as entradas.
OPENAI_API_KEY=coloque_a_chave_da_openai_aqui
OPENAI_MODEL=

# Operacao
DRY_RUN=true
POLL_SECONDS=180
MIN_ODD=1.80
MIN_CONFIDENCE=70
BOOKMAKERS=Bet365,Betano
SPORT=football
MAX_LIVE_EVENTS=20
# O fluxo BFBM/Betfair sempre varre no minimo 150 jogos TotalCorner ao vivo,
# mesmo quando MAX_LIVE_EVENTS fica menor para economizar nas outras fontes.
ODDS_DETAIL_LIMIT=5
DATABASE_PATH=bot.sqlite3
STARTUP_ALERT=true
ODDS_USE_MULTI=false

# Chave somente leitura para outro sistema consultar o cache Betfair deste bot.
# Use no header HTTP: X-Api-Key: valor_da_chave
BETFAIR_CACHE_API_KEY=

# Chave para o publisher local/VPS alimentar o cache Betfair deste bot.
# Use no header HTTP: X-Ingest-Token: valor_da_chave
BETFAIR_INGEST_TOKEN=

# Chave somente leitura para outro sistema consultar resultados/green/red/lucro.
# Use no header HTTP: X-Api-Key: valor_da_chave
RESULTS_API_KEY=

# Chave para a ponte local/VPS enviar ordens casadas/liquidadas do BFBM.
# Use no header HTTP: X-Sync-Token: valor_da_chave
BFBM_SYNC_TOKEN=
